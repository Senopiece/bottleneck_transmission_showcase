# Node.js dependencies and local tool output.
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python environments and caches.
**/.venv/
**/__pycache__/
*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
.coverage
coverage.xml

# Local configuration and secrets.
.env
.env.*
!.env.example
local.properties

# IDE and operating-system files.
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
desktop.ini

# Generic build and temporary output.
**/.gradle/
**/build/
*.log
*.tmp
*.temp

# Generated poster intermediates. Final PDF/PPTX remain publishable.
poster/assets/*.png
poster/optical_receiver_poster.html
poster/optical_receiver_poster.svg
poster/poster_qa.png

analysis/data/*

# Receiver datasets and generated artifacts.
receiver/datasets/raw/videos/**/*.mp4
receiver/datasets/raw/videos/**/*.mov
receiver/datasets/raw/videos/**/*.mkv
receiver/datasets/derived/**
!receiver/datasets/derived/**/
!receiver/datasets/derived/**/README.md

# Receiver Python tooling.
receiver/tools/.venv/
receiver/tools/__pycache__/
receiver/tools/**/__pycache__/
receiver/tools/*.egg-info/
receiver/tools/.pytest_cache/

# Training outputs.
receiver/training/.venv/
receiver/training/__pycache__/
receiver/training/**/__pycache__/
receiver/training/.pytest_cache/
receiver/training/**/runs/**
!receiver/training/**/runs/README.md

# Models
receiver/models/**
!receiver/models/**/
!receiver/models/**/README.md
